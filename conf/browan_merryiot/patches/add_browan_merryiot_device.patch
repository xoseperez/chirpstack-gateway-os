===================================================================
--- openwrt.orig/target/linux/rockchip/armv8/base-files/etc/board.d/02_network
+++ openwrt/target/linux/rockchip/armv8/base-files/etc/board.d/02_network
@@ -20,6 +20,9 @@ rockchip_setup_interfaces()
 	xunlong,orangepi-r1-plus-lts)
 		ucidef_set_interfaces_lan_wan 'eth1' 'eth0'
 		;;
