Index: openwrt/target/linux/rockchip/patches-6.6/131-arm64-dts-rockchip-add-Browan-MerryIoT.patch
===================================================================
--- /dev/null
+++ openwrt/target/linux/rockchip/patches-6.6/131-arm64-dts-rockchip-add-Browan-MerryIoT.patch
@@ -0,0 +1,736 @@
+Add the Browan MerryIoT Hotspot Miner V1 (RK3566) device tree.
+
+--- /dev/null
++++ b/arch/arm64/boot/dts/rockchip/rk3566-browan-merryiot.dts
+@@ -0,0 +1,721 @@
++// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
++/*
++ * Browan MerryIoT Hotspot Miner V1 (board silkscreen BROWAN_H1GW).
++ *
++ * RK3566 with an RK809 PMIC, a TCS4525 CPU rail, eMMC, a TF slot, an RTL8211F
++ * Gigabit PHY on GMAC1, an SDIO Wi-Fi module (AP6212A or AP6236) and a
++ * mini-PCIe style SX1302 LoRa card wired to SPI3. The LoRa card is not a PCIe
++ * device: only its supply, its SPI bus and a few GPIOs reach the SoC.
++ *
++ * Pin numbers, supplies and delays come from the vendor's factory device
++ * tree; where a value could not be confirmed on a unit, the comment next to
++ * it says so.
++ */
++
++/dts-v1/;
++
++#include <dt-bindings/gpio/gpio.h>
++#include <dt-bindings/input/input.h>
++#include <dt-bindings/interrupt-controller/irq.h>
++#include <dt-bindings/leds/common.h>
++#include <dt-bindings/pinctrl/rockchip.h>
++#include "rk3566.dtsi"
++
++/ {
++	model = "Browan MerryIoT Hotspot Miner V1";
++	compatible = "browan,merryiot", "rockchip,rk3566";
++
++	aliases {
++		/*
++		 * The boot loader writes a per-unit MAC address into the nodes
++		 * behind ethernetN. The Wi-Fi node is included because brcmfmac
++		 * takes its station address from the local-mac-address property
++		 * of its own node.
++		 */
++		ethernet0 = &gmac1;
++		ethernet1 = &brcmf;
++		led-boot = &led_system;
++		led-failsafe = &led_system;
++		led-running = &led_system;
++		led-upgrade = &led_system;
++		mmc0 = &sdhci;
++		mmc1 = &sdmmc0;
++		mmc2 = &sdmmc1;
++	};
++
++	chosen {
++		stdout-path = "serial2:1500000n8";
++	};
++
++	/*
++	 * The rear button sits on SARADC channel 0. It pulls the pin to ground
++	 * when pressed and the pin idles at the 1.8 V reference, so a single
++	 * threshold close to 0 V is enough. The label is how the boot loader
++	 * looks the button up.
++	 */
++	adc-keys {
++		compatible = "adc-keys";
++		io-channels = <&saradc 0>;
++		io-channel-names = "buttons";
++		keyup-threshold-microvolt = <1800000>;
++		poll-interval = <100>;
++
++		button-reset {
++			label = "reset";
++			linux,code = <KEY_RESTART>;
++			press-threshold-microvolt = <1750>;
++		};
++	};
++
++	/*
++	 * The vendor tree names GPIO0_D3..D6 status, system, wifi and eth
++	 * (all green, active high), while the product sheet lists the four
++	 * front LEDs as Power, Status, System and Wi-Fi. D6 is therefore taken
++	 * as Power and the rest follow the vendor names; the assignment has not
++	 * been confirmed on a unit. The class device names are
++	 * green:power, green:status, green:system and green:wlan.
++	 */
++	gpio-leds {
++		compatible = "gpio-leds";
++		pinctrl-names = "default";
++		pinctrl-0 = <&power_led_pin>, <&status_led_pin>,
++			    <&system_led_pin>, <&wlan_led_pin>,
++			    <&logo_led_pin>;
++
++		led_power: led-0 {
++			color = <LED_COLOR_ID_GREEN>;
++			function = LED_FUNCTION_POWER;
++			gpios = <&gpio0 RK_PD6 GPIO_ACTIVE_HIGH>;
++			default-state = "on";
++		};
++
++		led_status: led-1 {
++			color = <LED_COLOR_ID_GREEN>;
++			function = LED_FUNCTION_STATUS;
++			gpios = <&gpio0 RK_PD3 GPIO_ACTIVE_HIGH>;
++			default-state = "off";
++		};
++
++		led_system: led-2 {
++			color = <LED_COLOR_ID_GREEN>;
++			function = "system";
++			gpios = <&gpio0 RK_PD4 GPIO_ACTIVE_HIGH>;
++		};
++
++		led_wlan: led-3 {
++			color = <LED_COLOR_ID_GREEN>;
++			function = LED_FUNCTION_WLAN;
++			gpios = <&gpio0 RK_PD5 GPIO_ACTIVE_HIGH>;
++		};
++
++		/*
++		 * Logo LED on its own small board. Its colour is not known, so
++		 * it is named with a plain label instead of colour:function;
++		 * the class device is called "logo". The vendor tree lights it
++		 * from boot.
++		 */
++		led_logo: led-4 {
++			label = "logo";
++			gpios = <&gpio4 RK_PC7 GPIO_ACTIVE_HIGH>;
++			default-state = "on";
++		};
++	};
++
++	dc_12v: regulator-dc-12v {
++		compatible = "regulator-fixed";
++		regulator-name = "dc_12v";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <12000000>;
++		regulator-max-microvolt = <12000000>;
++	};
++
++	vcc3v3_sys: regulator-vcc3v3-sys {
++		compatible = "regulator-fixed";
++		regulator-name = "vcc3v3_sys";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <3300000>;
++		regulator-max-microvolt = <3300000>;
++		vin-supply = <&dc_12v>;
++	};
++
++	vcc5v0_sys: regulator-vcc5v0-sys {
++		compatible = "regulator-fixed";
++		regulator-name = "vcc5v0_sys";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <5000000>;
++		regulator-max-microvolt = <5000000>;
++		vin-supply = <&dc_12v>;
++	};
++
++	vcc5v0_usb: regulator-vcc5v0-usb {
++		compatible = "regulator-fixed";
++		regulator-name = "vcc5v0_usb";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <5000000>;
++		regulator-max-microvolt = <5000000>;
++		vin-supply = <&dc_12v>;
++	};
++
++	/*
++	 * The vendor tree drives GPIO0_A6 high from boot and GPIO0_A5 when the
++	 * OTG port runs as a host. It is not known which of the two enables
++	 * VBUS on the Type-A socket, so both are kept as the vendor does:
++	 * the host switch stays on, the OTG one follows the USB PHY.
++	 */
++	vcc5v0_usb_host: regulator-vcc5v0-usb-host {
++		compatible = "regulator-fixed";
++		enable-active-high;
++		gpio = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
++		pinctrl-names = "default";
++		pinctrl-0 = <&vcc5v0_usb_host_en>;
++		regulator-name = "vcc5v0_usb_host";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <5000000>;
++		regulator-max-microvolt = <5000000>;
++		vin-supply = <&vcc5v0_usb>;
++	};
++
++	vcc5v0_usb_otg: regulator-vcc5v0-usb-otg {
++		compatible = "regulator-fixed";
++		enable-active-high;
++		gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
++		pinctrl-names = "default";
++		pinctrl-0 = <&vcc5v0_usb_otg_en>;
++		regulator-name = "vcc5v0_usb_otg";
++		regulator-min-microvolt = <5000000>;
++		regulator-max-microvolt = <5000000>;
++		vin-supply = <&vcc5v0_usb>;
++	};
++
++	/*
++	 * Load switch on the supply of the LoRa card, enabled by GPIO4_A1. It
++	 * is kept on from boot: the concentrator daemon only drives the
++	 * SX1302 reset line and expects the card to be powered already. The
++	 * 3.3 V rating is that of a mini-PCIe card supply; it only documents
++	 * the rail, because the switch cannot change the voltage.
++	 */
++	vcc_lora: regulator-vcc-lora {
++		compatible = "regulator-fixed";
++		enable-active-high;
++		gpio = <&gpio4 RK_PA1 GPIO_ACTIVE_HIGH>;
++		pinctrl-names = "default";
++		pinctrl-0 = <&lora_power_en>;
++		regulator-name = "vcc_lora";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <3300000>;
++		regulator-max-microvolt = <3300000>;
++		vin-supply = <&vcc3v3_sys>;
++	};
++
++	/* WL_REG_ON of the Wi-Fi module plus its 32.768 kHz low-power clock. */
++	sdio_pwrseq: sdio-pwrseq {
++		compatible = "mmc-pwrseq-simple";
++		clocks = <&rk809 1>;
++		clock-names = "ext_clock";
++		pinctrl-names = "default";
++		pinctrl-0 = <&wifi_reg_on_h>;
++		post-power-on-delay-ms = <200>;
++		reset-gpios = <&gpio2 RK_PB1 GPIO_ACTIVE_LOW>;
++	};
++};
++
++&cpu0 {
++	cpu-supply = <&vdd_cpu>;
++};
++
++&cpu1 {
++	cpu-supply = <&vdd_cpu>;
++};
++
++&cpu2 {
++	cpu-supply = <&vdd_cpu>;
++};
++
++&cpu3 {
++	cpu-supply = <&vdd_cpu>;
++};
++
++/*
++ * RGMII with the MAC supplying the 125 MHz clock and adding the delays
++ * itself; the PHY adds none. The delay values and the clock direction are
++ * the vendor's.
++ */
++&gmac1 {
++	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
++	assigned-clock-parents = <&cru SCLK_GMAC1_RGMII_SPEED>, <&cru CLK_MAC1_2TOP>;
++	assigned-clock-rates = <0>, <125000000>;
++	clock_in_out = "output";
++	phy-handle = <&rgmii_phy1>;
++	phy-mode = "rgmii";
++	pinctrl-names = "default";
++	pinctrl-0 = <&gmac1m0_miim
++		     &gmac1m0_tx_bus2_level3
++		     &gmac1m0_rx_bus2
++		     &gmac1m0_rgmii_clk_level2
++		     &gmac1m0_rgmii_bus_level3>;
++	rx_delay = <0x2e>;
++	tx_delay = <0x41>;
++	status = "okay";
++};
