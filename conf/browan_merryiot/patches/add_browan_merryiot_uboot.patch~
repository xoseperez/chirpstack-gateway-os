++	};
++
++	/*
++	 * The rear button sits on SARADC channel 0. It pulls the pin to ground
++	 * when pressed and the pin idles at the 1.8 V reference, so a single
++	 * threshold close to 0 V is enough. The label is how the boot loader
++	 * looks the button up.
++	 */
++	adc-keys {
++		compatible = "adc-keys";
++		io-channels = <&saradc 0>;
++		io-channel-names = "buttons";
++		keyup-threshold-microvolt = <1800000>;
++		poll-interval = <100>;
++
++		button-reset {
