++	 * as Power and the rest follow the vendor names; the assignment has not
++	 * been confirmed on a unit. The class device names are
++	 * green:power, green:status, green:system and green:wlan.
++	 */
++	gpio-leds {
++		compatible = "gpio-leds";
++		pinctrl-names = "default";
