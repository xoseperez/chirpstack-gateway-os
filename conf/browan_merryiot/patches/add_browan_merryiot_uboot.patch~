++	aliases {
++		/*
++		 * The boot loader writes a per-unit MAC address into the nodes
++		 * behind ethernetN. The Wi-Fi node is included because brcmfmac
++		 * takes its station address from the local-mac-address property
++		 * of its own node.
++		 */
++		ethernet0 = &gmac1;
++		ethernet1 = &brcmf;
++		led-boot = &led_system;
++		led-failsafe = &led_system;
++		led-running = &led_system;
++		led-upgrade = &led_system;
++		mmc0 = &sdhci;
++		mmc1 = &sdmmc0;
++		mmc2 = &sdmmc1;
++	};
