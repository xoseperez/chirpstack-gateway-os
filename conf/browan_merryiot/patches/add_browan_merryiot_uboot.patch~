++			default-state = "on";
++		};
++
++		led_status: led-1 {
++			color = <LED_COLOR_ID_GREEN>;
++			function = LED_FUNCTION_STATUS;
++			gpios = <&gpio0 RK_PD3 GPIO_ACTIVE_HIGH>;
++			default-state = "off";
++		};
