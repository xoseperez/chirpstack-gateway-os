#!/bin/sh /etc/rc.common
# Runs the watcher that lights the Status LED while concentratord is running.
# It starts at boot and does not depend on the concentratord service itself.

USE_PROCD=1
START=99

LED="/sys/class/leds/green:status"

start_service() {
	[ -d "$LED" ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/concentratord-led
	procd_set_param respawn
	procd_close_instance
}

# rc.common calls this after procd has killed the watcher. stop_service runs
# before the kill, and a watcher still alive at that point could light the LED
# again right after it was turned off here.
service_stopped() {
	[ -d "$LED" ] && echo 0 > "$LED/brightness"
	return 0
}
